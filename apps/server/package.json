{
  "name": "server",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "deploy": "wrangler deploy --env dev --keep-vars",
    "deploy:prod": "wrangler deploy --env prod --keep-vars",
    "env:inject": "op inject -i .env.example -o .env --force",
    "dev": "wrangler d1 migrations apply prive-admin-dev --local && wrangler dev",
    "dev:worker": "wrangler d1 migrations apply prive-admin-dev --local && wrangler dev",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@hono/trpc-server": "catalog:",
    "@prive-admin-tanstack/api": "workspace:*",
    "@prive-admin-tanstack/auth": "workspace:*",
    "@prive-admin-tanstack/env": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@prive-admin-tanstack/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.55.0"
  }
}
