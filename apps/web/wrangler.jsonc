{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prive-admin-web",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "dev": {
      "workers_dev": true,
    },
    "prod": {
      "workers_dev": true,
    },
  },
}
