{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}!", "react-doctor.config.json"],
      "ignoreDependencies": ["@mantine/charts"],
      "project": ["src/**/*.{ts,tsx}!"]
    },
    "apps/server": {
      "project": ["src/**/*.ts!"]
    },
    "packages/auth": {
      "project": ["src/**/*.ts!"]
    },
    "packages/db": {
      "entry": ["src/schema/**/*.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/env": {
      "ignoreDependencies": ["cloudflare"],
      "project": ["src/**/*.ts!"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}!"]
    },
    "packages/config": {},
    "packages/api": {}
  }
}
