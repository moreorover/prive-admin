{
  "name": "prive-admin-tanstack",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "cloudflare:deploy": "vp run server:deploy && vp run web:deploy",
    "dev:web": "vp run --filter web dev",
    "server:deploy": "vp run --filter server deploy",
    "server:dev:worker": "vp run --filter server dev:worker",
    "web:deploy": "VITE_SERVER_URL=https://prive-admin-server-dev.mselvenis.workers.dev vp run --filter web build && vp run --filter web deploy",
    "db:push": "vp run --filter @prive-admin-tanstack/db db:push",
    "db:studio": "vp run --filter @prive-admin-tanstack/db db:studio",
    "db:generate": "vp run --filter @prive-admin-tanstack/db db:generate",
    "db:migrate": "vp run --filter @prive-admin-tanstack/db db:migrate",
    "d1:export-from-postgres": "tsx scripts/export_postgres_for_d1.ts",
    "d1:import:local": "tsx scripts/import_d1.ts --local",
    "d1:import:remote": "tsx scripts/import_d1.ts --remote",
    "d1:verify-import": "tsx scripts/verify_d1_import.ts",
    "compose:up": "docker compose -f docker-compose.dev.yml up -d",
    "compose:watch": "docker compose -f docker-compose.dev.yml up",
    "compose:stop": "docker compose -f docker-compose.dev.yml stop",
    "compose:down": "docker compose -f docker-compose.dev.yml down",
    "check": "vp lint && vp fmt --write",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@prive-admin-tanstack/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "knip": "^6.29.0",
    "pg": "^8.22.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.17.0"
}
